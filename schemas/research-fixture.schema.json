{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viet-tuvi-engine.dev/schemas/research-fixture-0.1.0.json",
  "title": "viet-tuvi-engine research fixture",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "profile", "input", "observations"],
    "properties": {
      "id": {"type": "string", "pattern": "^research-[0-9]+$"},
      "profile": {"type": "string", "minLength": 1},
      "input": {
        "type": "object",
        "required": ["yearCanChi", "lunarMonth", "lunarDay", "birthHourBranch", "gender"],
        "properties": {
          "yearCanChi": {"type": "string", "minLength": 1},
          "lunarMonth": {"type": "integer", "minimum": 1, "maximum": 12},
          "lunarMonthBranch": {"type": "string", "minLength": 1},
          "lunarDay": {"type": "integer", "minimum": 1, "maximum": 30},
          "birthHourBranch": {"type": "string", "minLength": 1},
          "gender": {"enum": ["male", "female"]},
          "elementPhase": {"type": "integer", "minimum": 2, "maximum": 6}
        },
        "additionalProperties": true
      },
      "observations": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "required": ["value", "status"],
          "properties": {
            "value": {},
            "branch": {"type": "string"},
            "status": {
              "enum": [
                "observed",
                "derived",
                "unresolved_due_to_missing_source_data",
                "conflict-candidate"
              ]
            },
            "sourceRefs": {
              "type": "array",
              "items": {"type": "string", "pattern": "^src-[0-9]+$"},
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": false
  }
}
