{
  "name": "viet-tuvi-engine",
  "version": "0.1.0",
  "description": "Deterministic, offline-first Vietnamese Tu Vi calculation engine",
  "license": "MIT",
  "keywords": [
    "tu-vi",
    "zi-wei-dou-shu",
    "vietnamese-astrology",
    "astrology",
    "mcp"
  ],
  "homepage": "https://github.com/iZenDeveloper/viet-tuvi-engine#readme",
  "bugs": {
    "url": "https://github.com/iZenDeveloper/viet-tuvi-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iZenDeveloper/viet-tuvi-engine.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    },
    "./mcp": {
      "types": "./dist/mcp/handler.d.ts",
      "import": "./dist/mcp/handler.js"
    },
    "./schema/chart": "./schemas/chart.schema.json",
    "./schema/input": "./schemas/calculate-input.schema.json",
    "./schema/oracle-fixture": "./schemas/oracle-fixture.schema.json",
    "./schema/research-fixture": "./schemas/research-fixture.schema.json",
    "./schema/source-manifest": "./schemas/source-manifest.schema.json",
    "./schema/profile-matrix": "./schemas/profile-matrix.schema.json",
    "./schema/unresolved-rules": "./schemas/unresolved-rules.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "bindings/python/viet_tuvi_engine/__init__.py",
    "bindings/python/viet_tuvi_engine/client.py",
    "bindings/python/viet_tuvi_engine/_js",
    "bindings/python/pyproject.toml",
    "bindings/python/README.md",
    "bindings/wasm",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "viet-tuvi": "./dist/cli.js",
    "viet-tuvi-mcp": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "asc assembly/calendar.ts --target release && node scripts/build-wasm-manifest.mjs",
    "build:python": "npm run build && node scripts/build-python-binding.mjs",
    "check:release": "npm run build:wasm && npm run build:python && node scripts/check-release.mjs",
    "test": "npm run build:wasm && npm run build:python && node --test test/*.test.js",
    "compare:fixture": "npm run build && node scripts/compare-fixture.mjs",
    "mcp:stdio": "npm run build && node dist/mcp-server.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "assemblyscript": "^0.27.31",
    "typescript": "^5.6.3"
  }
}
